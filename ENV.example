# Environment variables (local dev)
# Create a file named `.env.local` in the repo root and set:

# --- Supabase (Auth + optional lead capture) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (used to store partner/provider access requests to a table)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: link used by Request Access / Apply pages
NEXT_PUBLIC_SCHEDULE_DEMO_URL=

# --- Optional LLM keys ---
OPENAI_API_KEY=
# Optional override
# OPENAI_MODEL=gpt-4.1-mini
