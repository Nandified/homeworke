generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkOrderStatus {
  DRAFT
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttributionEventType {
  CLICK
  FORM_START
  FORM_COMPLETE
  REFERRAL
}

enum PartnerType {
  REAL_ESTATE
  LENDER
  INSPECTOR
  INSURANCE
}

enum UserRole {
  USER // legacy default (Phase 1)
  HOMEOWNER
  PARTNER
  OFFICE_MEMBER
  OFFICE_ADMIN
  EDITOR
  ADMIN
}

enum OfficeRole {
  MEMBER
  ADMIN
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole @default(USER)
  createdAt DateTime @default(now())

  sessions   Session[]
  workOrders WorkOrder[]
  auditLogs  AuditLog[]  @relation("AuditLogActorUser")

  officeMemberships OfficeMembership[]
  acceptedOfficeInvites OfficeInvite[] @relation("OfficeInviteAcceptedBy")

  properties Property[]
  partnerClients PartnerClient[] @relation("PartnerClientHomeowner")

  serviceEdits ServiceEditor[]
  pageEdits    PageEditor[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model MagicLinkToken {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([email])
  @@index([token])
}

model PartnerProfile {
  id          String      @id @default(cuid())
  proCode     String      @unique
  partnerType PartnerType @default(REAL_ESTATE)

  // Progressive onboarding (all optional & deferrable)
  displayName   String?
  brokerageName String?
  officeName    String?
  licenseState  String?
  licenseNumber String?
  phone         String?
  email         String?
  websiteUrl    String?
  bio           String?
  introVideoUrl String?
  socials       Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  originWorkOrders  WorkOrder[]        @relation("WorkOrderOriginPartner")
  sharedWorkOrders  WorkOrder[]        @relation("WorkOrderShareWithPartner")
  attributionEvents AttributionEvent[]
  auditLogs         AuditLog[]         @relation("AuditLogActorPartner")

  partnerClients PartnerClient[]

  @@index([proCode])
  @@index([partnerType])
}

model Office {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OfficeMembership[]
  invites     OfficeInvite[]

  @@index([slug])
}

model OfficeMembership {
  officeId  String
  userId    String
  role      OfficeRole @default(MEMBER)
  createdAt DateTime   @default(now())

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([officeId, userId])
  @@index([userId])
  @@index([officeId, role])
}

model OfficeInvite {
  id               String     @id @default(cuid())
  officeId         String
  email            String
  role             OfficeRole @default(MEMBER)
  token            String     @unique
  createdAt        DateTime   @default(now())
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?

  office          Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  acceptedByUser User?  @relation("OfficeInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([email])
  @@index([token])
}

model Property {
  id        String   @id @default(cuid())
  userId    String?
  nickname  String?
  address1  String
  address2  String?
  city      String?
  state     String?
  zip       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  workOrders WorkOrder[]

  @@index([userId])
}

model PartnerClient {
  id               String   @id @default(cuid())
  partnerId         String
  homeownerUserId   String
  canViewWorkOrders Boolean @default(true)
  canViewProperties Boolean @default(false)
  createdAt         DateTime @default(now())

  partner  PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  homeowner User         @relation("PartnerClientHomeowner", fields: [homeownerUserId], references: [id], onDelete: Cascade)

  @@unique([partnerId, homeownerUserId])
  @@index([homeownerUserId])
  @@index([partnerId])
}

model WorkOrder {
  id                  String    @id @default(cuid())
  userId              String?
  sessionToken        String?
  originPartnerId     String?
  shareWithPartnerId  String?
  propertyId          String?
  serviceCategory     String
  serviceSubcategory  String?
  issueDescription    String?
  urgencyLevel        String?
  propertyAddress     String? // legacy (Phase 1)
  propertyType        String? // legacy (Phase 1)
  preferredDate       DateTime?
  preferredWindow     String?
  status              WorkOrderStatus @default(DRAFT)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  originPartner    PartnerProfile?  @relation("WorkOrderOriginPartner", fields: [originPartnerId], references: [id], onDelete: SetNull)
  shareWithPartner PartnerProfile?  @relation("WorkOrderShareWithPartner", fields: [shareWithPartnerId], references: [id], onDelete: SetNull)
  property         Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  attributionEvents AttributionEvent[]

  @@index([userId])
  @@index([originPartnerId])
  @@index([shareWithPartnerId])
  @@index([propertyId])
  @@index([status])
}

model AttributionEvent {
  id          String               @id @default(cuid())
  workOrderId String
  partnerId   String
  type        AttributionEventType
  createdAt   DateTime             @default(now())

  workOrder WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([partnerId])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  actorPartnerId String?
  entityType     String
  entityId       String
  action         String
  data           Json     @default("{}")
  createdAt      DateTime @default(now())

  actorUser    User?           @relation("AuditLogActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPartner PartnerProfile? @relation("AuditLogActorPartner", fields: [actorPartnerId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([actorPartnerId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// CMS (MVP)
// ---------------------------------------------------------------------------

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@index([slug])
  @@index([sortOrder])
}

model Service {
  id          String           @id @default(cuid())
  categoryId  String?
  title       String
  slug        String           @unique
  icon        String?
  summary     String?
  examples    Json             @default("[]")
  notes       String?
  body        String?
  published   Boolean          @default(false)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  editors  ServiceEditor[]

  @@index([categoryId])
  @@index([published])
  @@index([slug, published])
}

model ServiceEditor {
  serviceId String
  userId    String
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([serviceId, userId])
  @@index([userId])
}

model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  body        String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  editors PageEditor[]

  @@index([slug])
  @@index([published])
}

model PageEditor {
  pageId    String
  userId    String
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pageId, userId])
  @@index([userId])
}

model ExpressEstimateCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  pdfHash   String
  location  String
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([pdfHash])
  @@index([expiresAt])
}
